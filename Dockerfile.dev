FROM node:22-alpine

WORKDIR /app

# Instala ferramentas úteis (git, openssl para o Prisma, bash, curl)
RUN apk add --no-cache git openssl bash curl

# Copia manifestos de dependências
COPY package*.json ./
COPY prisma ./prisma/

RUN npm install

# Copia entrypoint e dá permissão máxima de execução
COPY docker-entrypoint.sh /usr/local/bin/docker-entrypoint.sh
RUN chmod +x /usr/local/bin/docker-entrypoint.sh

# Copia o restante do código
COPY . .
RUN chmod -R 777 /app

EXPOSE 3000

ENTRYPOINT ["docker-entrypoint.sh"]
CMD ["npm", "run", "dev"]
