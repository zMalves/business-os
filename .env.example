# Porta e Host do Servidor Fastify (Business OS)
PORT=4017
HOST=0.0.0.0
NODE_ENV=development

# Conexão com MariaDB dedicado (business_os_db)
# Formato: mysql://USUARIO:SENHA@HOST:PORTA/NOME_DO_BANCO
DATABASE_URL="mysql://business_user:business_pass@localhost:3317/business_os_db"

# Provedor de IA padrão ("deepseek" ou "gemini" ou "openai")
AI_PROVIDER="deepseek"

# Chaves de API
GEMINI_API_KEY="sua_chave_gemini_aqui"
OPENAI_API_KEY="sua_chave_openai_aqui"
DEEPSEEK_API_KEY="sua_chave_deepseek_aqui"

# Configuração de Modelo
GEMINI_MODEL="gemini-2.5-flash"
DEEPSEEK_MODEL="deepseek-v4-flash"
DEEPSEEK_BASE_URL="https://api.deepseek.com/v1"

# Evolution API (WhatsApp)
EVOLUTION_API_URL="http://192.168.18.82:8082"
EVOLUTION_API_KEY="victoria_master_secret_2026"
EVOLUTION_INSTANCE_NAME="victoria"
WEBHOOK_BASE_URL="https://b-os.malves.dev.br"
WHATSAPP_ALLOWED_NUMBERS="5541995852423,554195852423,+5541995852423"

# Google Integration (Calendar, Gmail, Contacts, Tasks)
GOOGLE_CLIENT_ID="seu_google_client_id_aqui"
GOOGLE_CLIENT_SECRET="seu_google_client_secret_aqui"
GOOGLE_REDIRECT_URI="https://b-os.malves.dev.br/api/auth/google/callback"

# Claves de Deploy & Webhook
DEPLOY_KEY="business_master_secret_2026"
NOTIFY_WEBHOOK_SECRET="business_master_secret_2026"
COOKIE_SECRET="business_os_cookie_secret_2026"

# KlimaParts MCP Integration
